{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "Pro-Versed/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(styles\\.css|app\\.js|antigravity\\.js)",
      "dest": "/Pro-Versed/frontend/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/Pro-Versed/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Pro-Versed/frontend/index.html"
    }
  ]
}
